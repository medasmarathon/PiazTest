{
  "manifest_version": 3,
  "name": "Link Saver",
  "version": "1.0",
  "description": "Save and manage your favorite links",
  "permissions": ["tabs", "storage", "identity"],
  "host_permissions": ["http://localhost:3000/*", "http://ec2-13-212-45-193.ap-southeast-1.compute.amazonaws.com/*"],
  "action": {
    "default_popup": "./src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "./background.js"
  },
  "oauth2": {
    "client_id": "74124435618-vcb2d19nuaa3hb36eq45qnsq3016a5cg.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "web_accessible_resources": [
    {
      "resources": ["./src/dashboard/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}