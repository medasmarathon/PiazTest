{
  "name": "back-end",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "env NODE_ENV=development ts-node-dev src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "prod": "npm run build && npm run start",
    "start:prod": "cd dist && typeorm migration:run -d ./src/data-source.js && env NODE_ENV=prod node ./src/index.js",
    "typeorm": "cross-replace typeorm-ts-node-commonjs -d src/data-source.ts",
    "typeorm:migration:generate": "cross-replace typeorm-ts-node-commonjs -d src/data-source.ts migration:generate src/migration/$npm_config_name",
    "typeorm:migration:run": "cross-replace typeorm-ts-node-commonjs -d src/data-source.ts migration:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^5.0.2",
    "typeorm": "0.3.20",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "cross-replace": "^0.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
